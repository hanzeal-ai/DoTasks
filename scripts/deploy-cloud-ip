#!/bin/sh
set -eu

DEPLOY_ROOT=${DOTASKS_DEPLOY_ROOT:-$(pwd)}
ENV_FILE="$DEPLOY_ROOT/.env"
RUNTIME_DIR="$DEPLOY_ROOT/.dotasks-cloud"
COMPOSE_FILE="$RUNTIME_DIR/compose.yaml"

PUBLIC_IP=
PUBLIC_URL_INPUT=
PORT=8765
IMAGE=
HTTP_USER=dotasks
HTTP_PASSWORD=
AGENT_ID=default
AGENT_TOKEN=
ACCOUNT_MODE=
FORCE_ENV=0
REUSE_ENV=0
PRINT_SECRETS=1
LOADED_IMAGE=0

usage() {
  cat <<'EOF'
Usage:
  ./deploy-cloud-ip (--public-ip <IPv4> | --public-url <HTTPS URL>) \
    --image <GHCR image:tag> [options]

First deployment:
  ./deploy-cloud-ip \
    --public-ip 203.0.113.10 \
    --image ghcr.io/hanzeal-ai/dotasks:2026.09.03

Options:
  --public-url <URL>        HTTPS URL when a reverse proxy terminates TLS
  --port <port>              Public TCP port (default: 8765)
  --image <image:tag>        GHCR image; optional only with --reuse-env
  --http-user <user>         Browser login user (default: dotasks)
  --http-password <value>    Browser password (default: generated)
  --agent-id <id>            Local Agent ID (default: default)
  --agent-token <value>      Local Agent token (default: generated)
  --account-mode <mode>      single (default) or multi (HTTPS shared registration)
  --reuse-env                Preserve credentials and optionally update the image
  --force-env                Replace the existing configuration and credentials
  --loaded-image             Use a verified image already loaded into Docker
  --no-print-secrets         Keep generated credentials out of CI logs
  -h, --help                 Show this help
EOF
}

fail() {
  echo "Deployment failed: $*" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --public-ip|--public-url|--port|--image|--http-user|--http-password|--agent-id|--agent-token|--account-mode)
      [ "$#" -ge 2 ] || fail "$1 requires a value"
      case "$1" in
        --public-ip) PUBLIC_IP=$2 ;;
        --public-url) PUBLIC_URL_INPUT=$2 ;;
        --port) PORT=$2 ;;
        --image) IMAGE=$2 ;;
        --http-user) HTTP_USER=$2 ;;
        --http-password) HTTP_PASSWORD=$2 ;;
        --agent-id) AGENT_ID=$2 ;;
        --agent-token) AGENT_TOKEN=$2 ;;
        --account-mode) ACCOUNT_MODE=$2 ;;
      esac
      shift 2
      ;;
    --loaded-image)
      LOADED_IMAGE=1
      shift
      ;;
    --reuse-env)
      REUSE_ENV=1
      shift
      ;;
    --force-env)
      FORCE_ENV=1
      shift
      ;;
    --no-print-secrets)
      PRINT_SECRETS=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
done

[ -z "$PUBLIC_IP" ] || [ -z "$PUBLIC_URL_INPUT" ] || fail "use either --public-ip or --public-url, not both"
[ -n "$PUBLIC_IP$PUBLIC_URL_INPUT" ] || fail "--public-ip or --public-url is required"
[ "$FORCE_ENV" -eq 0 ] || [ "$REUSE_ENV" -eq 0 ] || fail "--force-env and --reuse-env cannot be combined"

if [ -n "$PUBLIC_IP" ] && ! printf '%s\n' "$PUBLIC_IP" | awk -F. '
  NF != 4 { exit 1 }
  {
    for (i = 1; i <= 4; i++) {
      if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
    }
  }
'; then
  fail "--public-ip must be a valid IPv4 address"
fi

case "$PORT" in
  ''|*[!0-9]*) fail "--port must be an integer between 1 and 65535" ;;
esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || fail "--port must be between 1 and 65535"

case "$HTTP_USER" in
  ''|*[!A-Za-z0-9._-]*) fail "--http-user may only contain letters, numbers, dot, underscore, and hyphen" ;;
esac
case "$AGENT_ID" in
  ''|*[!A-Za-z0-9._-]*) fail "--agent-id may only contain letters, numbers, dot, underscore, and hyphen" ;;
esac

command -v docker >/dev/null 2>&1 || fail "docker is not installed"
docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
command -v curl >/dev/null 2>&1 || fail "curl is not installed"

read_env() {
  awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); value=$0 } END { print value }' "$ENV_FILE"
}

write_env() {
  umask 077
  ENV_TMP="$ENV_FILE.tmp.$$"
  trap 'rm -f "$ENV_TMP"' EXIT HUP INT TERM
  {
    printf 'DOTASKS_IMAGE=%s\n' "$IMAGE"
    printf 'DOTASKS_PUBLIC_URL=%s\n' "$PUBLIC_URL"
    if [ "$ACCOUNT_MODE" = multi ]; then
      printf 'DOTASKS_ACCOUNT_MODE=multi\n'
    fi
    printf 'DOTASKS_HTTP_USER=%s\n' "$HTTP_USER"
    printf 'DOTASKS_HTTP_PASSWORD=%s\n' "$HTTP_PASSWORD"
    printf 'DOTASKS_AGENT_ID=%s\n' "$AGENT_ID"
    printf 'DOTASKS_AGENT_TOKEN=%s\n' "$AGENT_TOKEN"
    printf 'DOTASKS_BIND_ADDRESS=%s\n' "$BIND_ADDRESS"
    printf 'DOTASKS_BIND_PORT=%s\n' "$PORT"
  } > "$ENV_TMP"
  mv "$ENV_TMP" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  trap - EXIT HUP INT TERM
}

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
    return
  fi
  if command -v od >/dev/null 2>&1 && [ -r /dev/urandom ]; then
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
    return
  fi
  fail "openssl or od with /dev/urandom is required to generate credentials"
}

if [ -n "$PUBLIC_URL_INPUT" ]; then
  PUBLIC_URL=${PUBLIC_URL_INPUT%/}
  case "$PUBLIC_URL" in
    https://*) ;;
    *) fail "--public-url must begin with https://" ;;
  esac
  PUBLIC_HOST=${PUBLIC_URL#https://}
  case "$PUBLIC_HOST" in
    ''|*/*|*:*|*[!A-Za-z0-9.-]*|.*|*.|*..*) fail "--public-url must contain one public DNS name without a path or port" ;;
    *.*) ;;
    *) fail "--public-url must contain a public DNS name" ;;
  esac
  BIND_ADDRESS=127.0.0.1
else
  PUBLIC_URL="http://$PUBLIC_IP:$PORT"
  PUBLIC_HOST="$PUBLIC_IP:$PORT"
  BIND_ADDRESS=0.0.0.0
fi
if [ -f "$ENV_FILE" ] && [ "$FORCE_ENV" -eq 0 ]; then
  [ "$REUSE_ENV" -eq 1 ] || fail ".env already exists; use --reuse-env to keep it or --force-env to replace it"
  EXISTING_PUBLIC_URL=$(read_env DOTASKS_PUBLIC_URL)
  EXISTING_BIND_ADDRESS=$(read_env DOTASKS_BIND_ADDRESS)
  EXISTING_PORT=$(read_env DOTASKS_BIND_PORT)
  [ "$EXISTING_PUBLIC_URL" = "$PUBLIC_URL" ] || fail "existing DOTASKS_PUBLIC_URL does not match $PUBLIC_URL"
  # Image-only updates retain the established proxy/listener topology.
  printf '%s\n' "$EXISTING_BIND_ADDRESS" | awk -F. '
    NF != 4 { exit 1 }
    { for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
      }
    }
  ' || fail "existing DOTASKS_BIND_ADDRESS must be an IPv4 address"
  BIND_ADDRESS=$EXISTING_BIND_ADDRESS
  [ "$EXISTING_PORT" = "$PORT" ] || fail "existing DOTASKS_BIND_PORT does not match $PORT"
  EXISTING_IMAGE=$(read_env DOTASKS_IMAGE)
  [ -n "$IMAGE" ] || IMAGE=$EXISTING_IMAGE
  HTTP_USER=$(read_env DOTASKS_HTTP_USER)
  HTTP_PASSWORD=$(read_env DOTASKS_HTTP_PASSWORD)
  AGENT_ID=$(read_env DOTASKS_AGENT_ID)
  AGENT_TOKEN=$(read_env DOTASKS_AGENT_TOKEN)
  EXISTING_ACCOUNT_MODE=$(read_env DOTASKS_ACCOUNT_MODE)
  EXISTING_ACCOUNT_MODE=${EXISTING_ACCOUNT_MODE:-single}
  [ -z "$ACCOUNT_MODE" ] || [ "$ACCOUNT_MODE" = "$EXISTING_ACCOUNT_MODE" ] || fail "--reuse-env cannot change account mode; perform an explicit migration"
  ACCOUNT_MODE=$EXISTING_ACCOUNT_MODE
  ENV_MESSAGE="Reused credentials from $ENV_FILE"
else
  [ -n "$IMAGE" ] || fail "--image is required for the first deployment"
  if [ "${ACCOUNT_MODE:-single}" = single ]; then
    [ -n "$HTTP_PASSWORD" ] || HTTP_PASSWORD=$(generate_secret)
    [ -n "$AGENT_TOKEN" ] || AGENT_TOKEN=$(generate_secret)
  fi
  ENV_MESSAGE="Created $ENV_FILE with mode 0600"
fi

case "$IMAGE" in
  ''|*[!A-Za-z0-9._/:@-]*) fail "DOTASKS_IMAGE must be a valid registry image reference without whitespace" ;;
esac
IMAGE_NAME=${IMAGE##*/}
case "$IMAGE_NAME" in
  *:*) ;;
  *) fail "DOTASKS_IMAGE must include an explicit version tag" ;;
esac
ACCOUNT_MODE=${ACCOUNT_MODE:-single}
case "$ACCOUNT_MODE" in
  single|multi) ;;
  *) fail "account mode must be single or multi" ;;
esac
if [ "$ACCOUNT_MODE" = multi ]; then
  [ -n "$PUBLIC_URL_INPUT" ] || fail "multi account mode requires --public-url with HTTPS"
else
[ -n "$HTTP_USER" ] || fail "DOTASKS_HTTP_USER is missing from .env"
[ "${#HTTP_PASSWORD}" -ge 8 ] || fail "DOTASKS_HTTP_PASSWORD must contain at least 8 characters"
[ -n "$AGENT_ID" ] || fail "DOTASKS_AGENT_ID is missing from .env"
[ "${#AGENT_TOKEN}" -ge 24 ] || fail "DOTASKS_AGENT_TOKEN must contain at least 24 characters"
case "$HTTP_PASSWORD$AGENT_TOKEN" in
  *[!A-Za-z0-9._~-]*) fail "password and token may only contain URL-safe characters" ;;
esac
fi
write_env
echo "$ENV_MESSAGE"

mkdir -p "$RUNTIME_DIR"
COMPOSE_TMP="$COMPOSE_FILE.tmp.$$"
trap 'rm -f "$COMPOSE_TMP"' EXIT HUP INT TERM
cat > "$COMPOSE_TMP" <<'EOF'
services:
  dotasks:
    image: ${DOTASKS_IMAGE:?set DOTASKS_IMAGE}
    restart: unless-stopped
    environment:
      DOTASKS_MODE: cloud
      DOTASKS_HOST: 0.0.0.0
      DOTASKS_PORT: 8765
      DOTASKS_HOME: /data/dotasks
      DOTASKS_PUBLIC_URL: ${DOTASKS_PUBLIC_URL:?set DOTASKS_PUBLIC_URL}
      DOTASKS_ACCOUNT_MODE: ${DOTASKS_ACCOUNT_MODE:-single}
      DOTASKS_HTTP_USER: ${DOTASKS_HTTP_USER:-}
      DOTASKS_HTTP_PASSWORD: ${DOTASKS_HTTP_PASSWORD:-}
      DOTASKS_AGENT_ID: ${DOTASKS_AGENT_ID:-default}
      DOTASKS_AGENT_TOKEN: ${DOTASKS_AGENT_TOKEN:-}
    ports:
      - "${DOTASKS_BIND_ADDRESS:-127.0.0.1}:${DOTASKS_BIND_PORT:-8765}:8765"
    volumes:
      - dotasks-data:/data/dotasks

volumes:
  dotasks-data:
EOF
mv "$COMPOSE_TMP" "$COMPOSE_FILE"
chmod 600 "$COMPOSE_FILE"
trap - EXIT HUP INT TERM

compose() {
  docker compose \
    --project-name dotasks-cloud \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    "$@"
}

compose config >/dev/null
if [ "$LOADED_IMAGE" -eq 1 ]; then
  docker image inspect "$IMAGE" >/dev/null || fail "loaded image not found"
  compose up -d --remove-orphans --pull never
else
  if ! compose pull; then
    fail "image pull failed; verify the image reference and run docker login ghcr.io"
  fi
  compose up -d --remove-orphans
fi

HEALTH_URL="http://127.0.0.1:$PORT/api/health"
if [ "$ACCOUNT_MODE" = multi ]; then
  HEALTH_URL="http://127.0.0.1:$PORT/api/auth/status"
fi
HEALTH_BODY=
attempt=0
while [ "$attempt" -lt 30 ]; do
  if HEALTH_BODY=$(curl -fsS \
    -u "$HTTP_USER:$HTTP_PASSWORD" \
    -H "Host: $PUBLIC_HOST" \
    "$HEALTH_URL" 2>/dev/null); then
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done
[ -n "$HEALTH_BODY" ] || fail "cloud service did not answer its authenticated health check within 30 seconds"

echo
echo "DoTasks Cloud is running: $PUBLIC_URL"
echo "Image: $IMAGE"
if [ "$ACCOUNT_MODE" = multi ]; then
  echo "Shared account mode: users register through dotasks init --cloud-url $PUBLIC_URL"
elif [ "$PRINT_SECRETS" -eq 1 ]; then
  echo "Browser username: $HTTP_USER"
  echo "Browser password: $HTTP_PASSWORD"
  echo
  echo "On the Mac that runs DoTasks, configure the Local Agent once:"
  printf '%s\n' './scripts/start-agent configure \'
  printf "  --cloud-url '%s' \\\n" "$PUBLIC_URL"
  printf "  --agent-id '%s' \\\n" "$AGENT_ID"
  printf "  --agent-token '%s'\n" "$AGENT_TOKEN"
else
  echo "Credentials remain only in $ENV_FILE"
fi
echo
if [ -n "$PUBLIC_URL_INPUT" ]; then
  echo "Required Alibaba Cloud action: allow inbound TCP 80 and 443, then proxy $PUBLIC_HOST to 127.0.0.1:$PORT with WebSocket support."
else
  echo "Required Alibaba Cloud action: allow inbound TCP $PORT only from your own public IP."
  echo "This HTTP/IP setup is temporary; credentials are not encrypted in transit."
fi
