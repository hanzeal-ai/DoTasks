#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(dirname "$SCRIPT_DIR")
cd "$PROJECT_DIR"

PYTHON_BIN=${DOTASKS_PYTHON_BIN:-}
if [ -z "$PYTHON_BIN" ] && [ -x "$PROJECT_DIR/python/bin/python3" ]; then
  PYTHON_BIN="$PROJECT_DIR/python/bin/python3"
fi
if [ -z "$PYTHON_BIN" ] && [ -x /opt/homebrew/bin/python3 ]; then
  PYTHON_BIN=/opt/homebrew/bin/python3
fi
if [ -z "$PYTHON_BIN" ]; then
  PYTHON_BIN=$(command -v python3 || true)
fi
if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
  echo "DoTasks requires Python 3.14 or newer" >&2
  exit 1
fi
if ! "$PYTHON_BIN" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 14) else 1)'; then
  echo "DoTasks requires Python 3.14 or newer" >&2
  exit 1
fi

if [ -z "${DOTASKS_REMOTE_SERVICE:-}" ]; then
  DOTASKS_DATA_HOME=${DOTASKS_HOME:-$HOME/Library/Application Support/DoTasks}
  DOTASKS_CLOUD_CONFIG=${DOTASKS_AGENT_CONFIG:-$DOTASKS_DATA_HOME/cloud-agent.json}
  if [ -f "$DOTASKS_CLOUD_CONFIG" ]; then
    export DOTASKS_REMOTE_SERVICE=1
  fi
fi

exec "$PYTHON_BIN" -B -m taskboard.mcp_server "$@"
