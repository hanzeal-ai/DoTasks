#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
CODEX_ROOT=${DOTASKS_CODEX_ROOT:-${CODEX_HOME:-"$HOME/.codex"}}
PLUGIN_CREATOR_ROOT="$CODEX_ROOT/skills/.system/plugin-creator"
READ_MARKETPLACE="$PLUGIN_CREATOR_ROOT/scripts/read_marketplace_name.py"
UPDATE_CACHEBUSTER="$PLUGIN_CREATOR_ROOT/scripts/update_plugin_cachebuster.py"
VALIDATE_PLUGIN="$PLUGIN_CREATOR_ROOT/scripts/validate_plugin.py"
INSTALL_ROOT=${DOTASKS_HOME:-"$HOME/Library/Application Support/DoTasks"}
RUNTIME_ROOT="$INSTALL_ROOT/DoTasks Helper.app/Contents/Resources/runtime"

for required in "$READ_MARKETPLACE" "$UPDATE_CACHEBUSTER" "$VALIDATE_PLUGIN"; do
  if [ ! -f "$required" ]; then
    echo "Required plugin development helper not found: $required" >&2
    exit 1
  fi
done

CODEX_BIN=${DOTASKS_CODEX_BIN:-$(command -v codex || true)}
if [ -z "$CODEX_BIN" ] || [ ! -x "$CODEX_BIN" ]; then
  echo "codex CLI not found" >&2
  exit 1
fi

PYTHON_BIN=${DOTASKS_PYTHON_BIN:-$(command -v python3 || true)}
if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
  echo "python3 not found" >&2
  exit 1
fi

UV_BIN=${DOTASKS_UV_BIN:-$(command -v uv || true)}
if [ -z "$UV_BIN" ] || [ ! -x "$UV_BIN" ]; then
  echo "uv not found; it is required for isolated plugin validation" >&2
  exit 1
fi

echo "[1/7] Running the complete test suite"
"$SCRIPT_DIR/test"

echo "[2/7] Building, installing, and restarting DoTasks Helper"
"$SCRIPT_DIR/build-helper" --install

echo "[3/7] Updating the plugin cachebuster"
MARKETPLACE_NAME=$($PYTHON_BIN "$READ_MARKETPLACE")
$PYTHON_BIN "$UPDATE_CACHEBUSTER" "$PROJECT_ROOT"

PLUGIN_NAME=$($PYTHON_BIN -c 'import json,sys; print(json.load(open(sys.argv[1]))["name"])' "$PROJECT_ROOT/.codex-plugin/plugin.json")
PLUGIN_VERSION=$($PYTHON_BIN -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$PROJECT_ROOT/.codex-plugin/plugin.json")
CACHE_PARENT="$CODEX_ROOT/plugins/cache/$MARKETPLACE_NAME/$PLUGIN_NAME"
LEGACY_CACHE_VERSIONS=
if [ -d "$CACHE_PARENT" ]; then
  for cached_path in "$CACHE_PARENT"/*; do
    [ -e "$cached_path" ] || [ -L "$cached_path" ] || continue
    cached_version=${cached_path##*/}
    LEGACY_CACHE_VERSIONS="$LEGACY_CACHE_VERSIONS $cached_version"
  done
fi

echo "[4/7] Validating the plugin"
"$UV_BIN" run --no-project --with PyYAML python "$VALIDATE_PLUGIN" "$PROJECT_ROOT"

echo "[5/7] Reinstalling $PLUGIN_NAME@$MARKETPLACE_NAME"
"$CODEX_BIN" plugin add "$PLUGIN_NAME@$MARKETPLACE_NAME"

CACHE_ROOT="$CODEX_ROOT/plugins/cache/$MARKETPLACE_NAME/$PLUGIN_NAME/$PLUGIN_VERSION"
if [ ! -d "$CACHE_ROOT" ]; then
  echo "Installed plugin cache not found: $CACHE_ROOT" >&2
  exit 1
fi

# Codex task history stores skill attachments as absolute versioned cache paths.
# Keep those paths resolvable after development reinstalls replace the cache.
for cached_version in $LEGACY_CACHE_VERSIONS; do
  [ "$cached_version" = "$PLUGIN_VERSION" ] && continue
  legacy_path="$CACHE_PARENT/$cached_version"
  if [ -L "$legacy_path" ]; then
    /bin/unlink "$legacy_path"
  elif [ -e "$legacy_path" ]; then
    continue
  fi
  /bin/ln -s "$PLUGIN_VERSION" "$legacy_path"
done

compare_path() {
  source_path=$1
  installed_path=$2
  if [ ! -e "$installed_path" ]; then
    echo "Installed path not found: $installed_path" >&2
    exit 1
  fi
  if ! /usr/bin/diff -qr -x __pycache__ -x '*.pyc' "$source_path" "$installed_path" >/dev/null; then
    echo "Installed content differs from source: $source_path -> $installed_path" >&2
    /usr/bin/diff -qr -x __pycache__ -x '*.pyc' "$source_path" "$installed_path" >&2 || true
    exit 1
  fi
}

echo "[6/7] Verifying plugin cache and packaged runtime parity"
for relative in .codex-plugin .mcp.json core taskboard skills scripts; do
  compare_path "$PROJECT_ROOT/$relative" "$CACHE_ROOT/$relative"
done
for relative in core taskboard skills static; do
  compare_path "$PROJECT_ROOT/$relative" "$RUNTIME_ROOT/$relative"
done
for relative in start mcp-server; do
  compare_path "$PROJECT_ROOT/scripts/$relative" "$RUNTIME_ROOT/scripts/$relative"
done

echo "[7/7] Verifying the restarted service"
health_attempt=0
while ! HEALTH=$(/usr/bin/curl -fsS http://127.0.0.1:8765/api/health 2>/dev/null); do
  health_attempt=$((health_attempt + 1))
  if [ "$health_attempt" -ge 40 ]; then
    echo "DoTasks service did not become healthy within 10 seconds" >&2
    exit 1
  fi
  /bin/sleep 0.25
done
$PYTHON_BIN -c '
import json, sys
payload = json.loads(sys.argv[1])
if payload.get("ok") is not True:
    raise SystemExit("DoTasks health check did not report ok=true")
' "$HEALTH"

echo "Full update complete: $PLUGIN_NAME $PLUGIN_VERSION"
echo "Start a new Codex task to load the updated plugin skills and MCP tools."
