#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

UV_BIN=${DOTASKS_UV_BIN:-}
if [ -z "$UV_BIN" ]; then
  for candidate in /opt/homebrew/bin/uv /usr/local/bin/uv "$HOME/.local/bin/uv"; do
    if [ -x "$candidate" ]; then
      UV_BIN=$candidate
      break
    fi
  done
fi
if [ -z "$UV_BIN" ]; then
  UV_BIN=$(command -v uv || true)
fi
if [ -z "$UV_BIN" ] || [ ! -x "$UV_BIN" ]; then
  echo "uv not found; install uv to run the locked Python test environment" >&2
  exit 1
fi

NODE_BIN=${DOTASKS_NODE_BIN:-}
if [ -z "$NODE_BIN" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node "$HOME"/.nvm/versions/node/*/bin/node; do
    if [ -x "$candidate" ]; then
      NODE_BIN=$candidate
    fi
  done
fi
if [ -z "$NODE_BIN" ]; then
  NODE_BIN=$(command -v node || true)
fi
if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "node not found; it is required by the frontend tests" >&2
  exit 1
fi
DOTASKS_NODE_BIN=$NODE_BIN
export DOTASKS_NODE_BIN

cd "$PROJECT_ROOT"
if [ "$#" -eq 0 ]; then
  set -- discover -s tests -v
fi
exec "$UV_BIN" run \
  --no-project \
  --python 3.9.25 \
  --with-requirements "$PROJECT_ROOT/requirements.lock" \
  python -m unittest "$@"
