# Use the server IP during private testing, for example http://203.0.113.10:8765.
# Use the final HTTPS origin after a domain and reverse proxy are configured.
DOTASKS_PUBLIC_URL=http://127.0.0.1:8765
# Shared registration cloud: multi, with DOTASKS_PUBLIC_URL=https://dotasks.hanzeal.com.
# single preserves the existing operator instance; no implicit data migration.
DOTASKS_ACCOUNT_MODE=single
DOTASKS_HTTP_USER=dotasks
DOTASKS_HTTP_PASSWORD=replace-with-a-long-random-password
DOTASKS_AGENT_ID=default
DOTASKS_AGENT_TOKEN=replace-with-an-independent-random-token-at-least-24-characters

# The default listens only on the server itself for a reverse proxy.
# Set 0.0.0.0 only for temporary IP-based testing with a strict cloud firewall.
DOTASKS_BIND_ADDRESS=127.0.0.1
DOTASKS_BIND_PORT=8765
# Optional advisory decision service (off | shadow | rank).
# Configure on the DoTasks state owner: cloud when cloud mode is used.
DOTASKS_DECISION_MODE=off
DOTASKS_DECISION_URL=http://127.0.0.1:8791
DOTASKS_DECISION_TOKEN_FILE=
DOTASKS_DECISION_TIMEOUT=5
